{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.supabase/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.docker/config.json)",
      "Read(~/Library/Application Support/com.vercel.cli/**)",
      "Read(~/.local/share/com.vercel.cli/**)",
      "Read(~/.now/**)",
      "Edit(.env*)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Edit(/.gitleaks.toml)",
      "Edit(/.gitleaksignore)",
      "Edit(/.git/config)",
      "Edit(/.git/config.worktree)",
      "Edit(/.git/hooks/**)",
      "Bash(git push*)",
      "Bash(git add -A*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git add --all*)",
      "Bash(git branch -D*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)"
    ],
    "ask": [
      "Bash(git commit*)"
    ],
    "allow": [
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "./.githooks",
        "./.github",
        "./.gitleaks.toml",
        "./.gitleaksignore",
        "./.env*",
        "./**/.env*"
      ],
      "denyRead": [
        "./.env*",
        "./**/.env*"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "SUPABASE_ACCESS_TOKEN", "mode": "deny" },
        { "name": "VERCEL_TOKEN", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org"
      ]
    }
  }
}
